# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-segura-generada
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
DATABASE_URL=postgres://bookstore_user:bookstore_pass@localhost:5432/bookstore

# Configuracion de negocio
LOCAL_CURRENCY=EUR
DEFAULT_EXCHANGE_RATE=0.85
PROFIT_MARGIN_PERCENTAGE=40

# API de tasas de cambio
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TIMEOUT_SECONDS=5
