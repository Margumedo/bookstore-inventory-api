{
  "info": {
    "_postman_id": "b00k570r-e1nv-4e70-9a91-c011ec710001",
    "name": "Bookstore Inventory API",
    "description": "Coleccion de entrega. {{base_url}} apunta a produccion. book_id va en path (Params) e isbn en el body. Importar y correr en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://bookstore-inventory-api-phzz.onrender.com"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const bookId = pm.variables.get('book_id');",
          "const skipPathOverride = pm.info.requestName && pm.info.requestName.indexOf('404') !== -1;",
          "if (bookId && !skipPathOverride) {",
          "    pm.request.url.variables.upsert({ key: 'book_id', value: String(bookId) });",
          "}",
          "const isbn = pm.variables.get('isbn');",
          "if (isbn && pm.request.method === 'PUT' && pm.request.body && pm.request.body.raw) {",
          "    try {",
          "        const body = JSON.parse(pm.request.body.raw);",
          "        if (Object.prototype.hasOwnProperty.call(body, 'isbn')) {",
          "            body.isbn = isbn;",
          "            pm.request.body.raw = JSON.stringify(body);",
          "        }",
          "    } catch (e) {}",
          "}",
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    },
    {
      "name": "02 Crear libro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Libro creado (201)', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.expect(body.isbn).to.be.a('string');",
              "    pm.expect(body.selling_price_local).to.eql(null);",
              "    pm.variables.set('book_id', String(body.id));",
              "    pm.variables.set('isbn', body.isbn);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
